# AgriSense environment variables (copy to .env for local reference only).
# Flutter reads these at compile time via --dart-define flags.

# Gemini API Key - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Sarvam AI API Key - https://sarvam.ai/
SARVAM_API_KEY=

# Firebase (from Firebase Console > Project settings)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=com.agrisense.agrisense

# Example run command:
# flutter run --dart-define=FIREBASE_API_KEY=your_key --dart-define=FIREBASE_APP_ID=your_app_id ...
